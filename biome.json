{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.cache",
      "!**/.output",
      "!**/.wxt",
      "!**/dist",
      "!**/artifacts",
      "!**/node_modules",
      "!**/bun.lock"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  }
}
