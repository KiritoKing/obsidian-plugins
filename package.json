{
  "name": "obsidian-plugins-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.tooling.json && bun run --filter '@chlrc/*' typecheck",
    "test": "bun test packages scripts",
    "test:browser": "bun run scripts/test-browser.ts",
    "build": "bun run --filter '@chlrc/*' build",
    "audit:public": "bun run scripts/check-public.ts",
    "check": "bun run audit:public && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run audit:public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.3.14",
    "@types/chrome": "0.3.6",
    "@types/node": "24.3.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  }
}
